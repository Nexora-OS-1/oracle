<Window x:Class="OracleApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ORACLE · Understand your system" Width="1320" Height="850" MinWidth="960" MinHeight="640" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="17,18,16,16">
      <StackPanel DockPanel.Dock="Top" Margin="2,5,2,28"><StackPanel Orientation="Horizontal"><Image x:Name="BrandMark" Width="34" Height="34" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ORACLE" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Understand your system" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/></StackPanel></StackPanel></StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation" KeyboardNavigation.TabNavigation="Continue"/></ScrollViewer>
      <StackPanel DockPanel.Dock="Bottom" Margin="2,16,2,5"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,13"/><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Local session" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><TextBlock Text="ORACLE  2.0.0" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="34,27,34,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,22"><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="PageContent"/></ScrollViewer><TextBlock x:Name="FooterStatus" Grid.Row="2" Text="Ready" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
    </Grid>
  </Grid>
</Window>
